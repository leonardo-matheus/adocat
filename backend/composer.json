{
    "name": "adocat/api",
    "description": "API REST da ONG AdoCat",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "aws/aws-sdk-php": "^3.0",
        "laminas/laminas-diactoros": "^3.5",
        "mezzio/mezzio": "^3.21",
        "mezzio/mezzio-fastroute": "^3.13",
        "phpmailer/phpmailer": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AdoCat\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php -l public/index.php && php -l src/App.php && php -l src/Database.php"
    },
    "config": {
        "sort-packages": true
    }
}
