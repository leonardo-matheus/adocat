# demo: dados de exemplo persistidos somente neste navegador.
# api: conecta ao backend PHP e MySQL; configure o backend antes de mudar.
VITE_DATA_MODE=demo
VITE_API_URL=/api
# Altere apenas se o servidor PHP local usar outra porta.
API_PROXY_TARGET=http://127.0.0.1:8080
# Build padrão: rotas normais. O modo pages usa rotas hash automaticamente.
VITE_ROUTER_MODE=browser
# Caminho público; o GitHub Actions preenche automaticamente no deploy.
VITE_BASE_PATH=/
